:root {
  --bg-dark: #0f1115;
  --bg-panel: #161a21;
  --bg-panel-alt: #1c212b;
  --border-color: #262c38;
  --text-primary: #e8eaed;
  --text-secondary: #9aa4b2;
  --accent: #4f8cff;
  --accent-hover: #6ea0ff;
  --danger: #ff5c5c;
  --success: #35d488;
  --warning: #ffb84f;
  --radius: 10px;
  --transition-fast: 0.15s ease;
  --transition-med: 0.3s ease;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg-dark);
  color: var(--text-primary);
  font-family: "Inter", "Segoe UI", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ---------------- Animations ---------------- */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-12px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes shimmer {
  0% { background-position: -200px 0; }
  100% { background-position: calc(200px + 100%) 0; }
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  animation: fadeIn var(--transition-med) ease;
}

/* ---------------- Navbar ---------------- */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border-color);
  animation: fadeIn var(--transition-med) ease;
}

.navbar-brand {
  font-weight: 600;
  font-size: 1.05rem;
  letter-spacing: 0.3px;
}

.navbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.navbar-user {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.navbar-logout {
  background: transparent;
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 6px 14px;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}

.navbar-logout:hover {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}

.navbar-logout:active {
  transform: scale(0.96);
}

/* ---------------- Body layout ---------------- */
.app-body {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.app-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px 28px;
  animation: fadeInUp var(--transition-med) ease;
}

/* ---------------- Sidebar ---------------- */
.sidebar {
  width: 220px;
  background: var(--bg-panel);
  border-right: 1px solid var(--border-color);
  padding: 18px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-link {
  padding: 10px 14px;
  border-radius: var(--radius);
  color: var(--text-secondary);
  font-size: 0.92rem;
  transition: background var(--transition-fast), color var(--transition-fast), padding-left var(--transition-fast);
  animation: slideInLeft var(--transition-med) ease;
}

.sidebar-link:hover {
  background: var(--bg-panel-alt);
  color: var(--text-primary);
  padding-left: 18px;
}

.sidebar-link-active {
  background: rgba(79, 140, 255, 0.12);
  color: var(--accent);
  font-weight: 600;
  border-left: 3px solid var(--accent);
}

/* ---------------- Buttons (generic) ---------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 18px;
  border-radius: var(--radius);
  border: none;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
}

.btn-primary {
  background: var(--accent);
  color: #fff;
}

.btn-primary:hover {
  background: var(--accent-hover);
  box-shadow: 0 4px 14px rgba(79, 140, 255, 0.35);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0) scale(0.97);
}

.btn-danger {
  background: var(--danger);
  color: #fff;
}

.btn-danger:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}

/* ---------------- Cards / Panels ---------------- */
.card {
  background: var(--bg-panel);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 18px;
  animation: fadeInUp var(--transition-med) ease;
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}

.card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

/* ---------------- Stat Cards ---------------- */
.stat-card {
  background: var(--bg-panel);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  animation: fadeInUp var(--transition-med) ease;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
}

.stat-value {
  font-size: 1.7rem;
  font-weight: 700;
}

.stat-label {
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.stat-tone-success .stat-value { color: var(--success); }
.stat-tone-warning .stat-value { color: var(--warning); }
.stat-tone-danger  .stat-value { color: var(--danger); }
.stat-tone-neutral .stat-value { color: var(--accent); }

/* ---------------- Loading ---------------- */
.loading-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 40px;
  color: var(--text-secondary);
  animation: fadeIn var(--transition-med) ease;
}

.loading-spinner {
  width: 34px;
  height: 34px;
  border: 3px solid var(--border-color);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-block p {
  animation: pulse 1.6s ease-in-out infinite;
}

/* ---------------- Skeleton (optional loading placeholder) ---------------- */
.skeleton {
  background: linear-gradient(90deg, var(--bg-panel) 25%, var(--bg-panel-alt) 37%, var(--bg-panel) 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: var(--radius);
}

/* ---------------- Forms ---------------- */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.form-group label {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.form-group input,
.form-group select,
.form-group textarea {
  background: var(--bg-panel-alt);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 10px 12px;
  color: var(--text-primary);
  font-size: 0.92rem;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.15);
}

/* ---------------- Login Page ---------------- */
.login-page {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at top, #1a1f2b 0%, var(--bg-dark) 70%);
  position: relative;
  overflow: hidden;
}

.login-page::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(79, 140, 255, 0.03) 2px, rgba(79, 140, 255, 0.03) 4px),
    repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(79, 140, 255, 0.03) 2px, rgba(79, 140, 255, 0.03) 4px);
  animation: gridMove 20s linear infinite;
  pointer-events: none;
}

.login-page::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(79, 140, 255, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: pulse 4s ease-in-out infinite;
  pointer-events: none;
}

@keyframes gridMove {
  0% {
    transform: translate(0, 0);
  }
  100% {
    transform: translate(40px, 40px);
  }
}

.login-box {
  width: 360px;
  background: var(--bg-panel);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 32px;
  animation: fadeInUp 0.4s ease;
  position: relative;
  z-index: 1;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.login-box h1 {
  font-size: 1.3rem;
  margin-bottom: 4px;
  background: linear-gradient(135deg, #4f8cff 0%, #35d488 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.login-box p {
  color: var(--text-secondary);
  font-size: 0.85rem;
  margin-bottom: 24px;
}

.login-error {
  background: rgba(255, 92, 92, 0.12);
  border: 1px solid var(--danger);
  color: var(--danger);
  padding: 8px 12px;
  border-radius: var(--radius);
  font-size: 0.85rem;
  margin-bottom: 16px;
  animation: fadeIn var(--transition-fast) ease;
}

/* ---------------- Landing Page ---------------- */
.landing-page {
  height: 100%;
  background: var(--bg-dark);
  position: relative;
  overflow-y: auto;
}

/* Nav */
.landing-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 5%;
  background: rgba(22, 26, 33, 0.8);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
}

.landing-logo-mark {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 1.2rem;
}

.landing-logo-dot {
  width: 10px;
  height: 10px;
  background: linear-gradient(135deg, #4f8cff, #35d488);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

.landing-nav-links {
  display: flex;
  align-items: center;
  gap: 32px;
}

.landing-nav-links a {
  color: var(--text-secondary);
  font-size: 0.95rem;
  transition: color var(--transition-fast);
}

.landing-nav-links a:hover {
  color: var(--accent);
}

/* Hero */
.landing-hero {
  position: relative;
  min-height: 95vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80px 5%;
  overflow: hidden;
  background: radial-gradient(ellipse at top, #1a2332 0%, #0d1117 50%, #080b10 100%);
}

.landing-hero-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

/* Floating Icons */
.floating-icons {
  position: absolute;
  width: 100%;
  height: 100%;
}

.float-icon {
  position: absolute;
  animation: floatUpDown 6s ease-in-out infinite;
}

.icon-card {
  width: 70px;
  height: 70px;
  background: rgba(22, 26, 33, 0.9);
  border: 2px solid rgba(53, 212, 136, 0.6);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.4),
    0 0 40px rgba(53, 212, 136, 0.3);
  backdrop-filter: blur(10px);
  transition: transform 0.3s ease;
}

.float-icon:hover .icon-card {
  transform: scale(1.1) rotate(5deg);
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.5),
    0 0 60px rgba(53, 212, 136, 0.5);
}

.icon-1 { animation-delay: 0s; animation-duration: 5s; }
.icon-2 { animation-delay: 1s; animation-duration: 6s; }
.icon-3 { animation-delay: 2s; animation-duration: 7s; }
.icon-4 { animation-delay: 0.5s; animation-duration: 5.5s; }
.icon-5 { animation-delay: 1.5s; animation-duration: 6.5s; }
.icon-6 { animation-delay: 2.5s; animation-duration: 7.5s; }

@keyframes floatUpDown {
  0%, 100% {
    transform: translateY(0) translateX(0);
  }
  25% {
    transform: translateY(-20px) translateX(10px);
  }
  50% {
    transform: translateY(0) translateX(-10px);
  }
  75% {
    transform: translateY(20px) translateX(5px);
  }
}

/* Connection Lines */
.connection-lines {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0.3;
}

.animated-line {
  fill: none;
  stroke: url(#lineGradient);
  stroke-width: 2;
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  animation: drawLine 8s ease-in-out infinite;
}

.line-1 { animation-delay: 0s; }
.line-2 { animation-delay: 2s; }
.line-3 { animation-delay: 4s; }
.line-4 { animation-delay: 6s; }

@keyframes drawLine {
  0%, 20% {
    stroke-dashoffset: 1000;
    opacity: 0;
  }
  40%, 60% {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  80%, 100% {
    stroke-dashoffset: -1000;
    opacity: 0;
  }
}

/* Glowing Orbs */
.glow-orbs {
  position: absolute;
  width: 100%;
  height: 100%;
}

.orb {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
  animation: orbFloat 10s ease-in-out infinite;
}

.orb-1 {
  background: radial-gradient(circle, rgba(53, 212, 136, 0.5), transparent);
  top: 20%;
  left: 15%;
  animation-delay: 0s;
}

.orb-2 {
  background: radial-gradient(circle, rgba(79, 140, 255, 0.5), transparent);
  top: 60%;
  right: 10%;
  animation-delay: 3s;
}

.orb-3 {
  background: radial-gradient(circle, rgba(53, 212, 136, 0.4), transparent);
  bottom: 10%;
  left: 40%;
  animation-delay: 6s;
}

@keyframes orbFloat {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  50% {
    transform: translate(30px, -30px) scale(1.1);
  }
}

/* Circuit Pattern */
.circuit-pattern {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(53, 212, 136, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(53, 212, 136, 0.05) 1px, transparent 1px);
  background-size: 50px 50px;
  animation: circuitMove 20s linear infinite;
}

@keyframes circuitMove {
  0% {
    background-position: 0 0;
  }
  100% {
    background-position: 50px 50px;
  }
}

/* Circuit board pattern */
.landing-hero-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(53, 212, 136, 0.08) 2px, transparent 2px),
    linear-gradient(90deg, rgba(53, 212, 136, 0.08) 2px, transparent 2px),
    linear-gradient(rgba(79, 140, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(79, 140, 255, 0.05) 1px, transparent 1px);
  background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
  animation: circuitFlow 30s linear infinite;
}

/* Glowing cyan squares (circuit nodes) */
.landing-hero-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 15% 25%, rgba(53, 212, 136, 0.4) 0%, transparent 3%),
    radial-gradient(circle at 85% 15%, rgba(79, 140, 255, 0.4) 0%, transparent 3%),
    radial-gradient(circle at 70% 80%, rgba(53, 212, 136, 0.3) 0%, transparent 2%),
    radial-gradient(circle at 25% 70%, rgba(79, 140, 255, 0.3) 0%, transparent 2%),
    radial-gradient(circle at 50% 40%, rgba(255, 184, 79, 0.3) 0%, transparent 2%),
    radial-gradient(circle at 90% 60%, rgba(53, 212, 136, 0.35) 0%, transparent 2.5%);
  animation: nodesPulse 4s ease-in-out infinite;
}

@keyframes circuitFlow {
  0% { transform: translate(0, 0); }
  100% { transform: translate(100px, 100px); }
}

@keyframes nodesPulse {
  0%, 100% { opacity: 1; filter: brightness(1); }
  50% { opacity: 0.6; filter: brightness(1.5); }
}

/* Matrix Digital Rain */
.matrix-rain {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  opacity: 0.3;
}

.matrix-column {
  position: absolute;
  top: -100%;
  width: 20px;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: rgba(53, 212, 136, 0.8);
  font-family: 'Courier New', monospace;
  font-size: 14px;
  font-weight: bold;
  animation: matrixFall 8s linear infinite;
  text-shadow: 0 0 8px rgba(53, 212, 136, 0.8);
}

@keyframes matrixFall {
  0% {
    transform: translateY(-100%);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(100vh);
    opacity: 0;
  }
}

/* Floating Evidence Cards */
.evidence-float {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.evidence-card {
  position: absolute;
  width: 80px;
  height: 100px;
  background: rgba(22, 26, 33, 0.7);
  border: 2px solid rgba(53, 212, 136, 0.5);
  border-radius: 8px;
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20px rgba(53, 212, 136, 0.3);
  animation: evidenceFloat 15s ease-in-out infinite;
  overflow: hidden;
}

.card-icon {
  font-size: 2.5rem;
  filter: drop-shadow(0 0 10px rgba(53, 212, 136, 0.6));
  animation: iconBounce 3s ease-in-out infinite;
}

.card-scan-line {
  position: absolute;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(53, 212, 136, 1), transparent);
  animation: cardScan 2s linear infinite;
}

@keyframes cardScan {
  0% { top: 0%; opacity: 0; }
  50% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

@keyframes iconBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.evidence-1 {
  top: 15%;
  left: 10%;
  animation-delay: 0s;
  animation-duration: 12s;
}

.evidence-2 {
  top: 25%;
  right: 15%;
  animation-delay: 3s;
  animation-duration: 14s;
}

.evidence-3 {
  bottom: 25%;
  left: 12%;
  animation-delay: 6s;
  animation-duration: 16s;
}

.evidence-4 {
  bottom: 20%;
  right: 10%;
  animation-delay: 9s;
  animation-duration: 13s;
}

@keyframes evidenceFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-20px) rotate(2deg);
  }
  50% {
    transform: translateY(0) rotate(-2deg);
  }
  75% {
    transform: translateY(20px) rotate(1deg);
  }
}

/* Laser Scanner Lines */
.laser-scanners {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  opacity: 0.4;
}

.laser-line {
  position: absolute;
  background: linear-gradient(to right, transparent, rgba(53, 212, 136, 0.8), transparent);
  box-shadow: 0 0 20px rgba(53, 212, 136, 0.6);
}

.laser-horizontal-1 {
  width: 100%;
  height: 2px;
  top: 30%;
  animation: laserScanHorizontal 4s ease-in-out infinite;
}

.laser-horizontal-2 {
  width: 100%;
  height: 2px;
  top: 70%;
  animation: laserScanHorizontal 5s ease-in-out infinite reverse;
  animation-delay: 2s;
}

.laser-vertical-1 {
  width: 2px;
  height: 100%;
  left: 25%;
  background: linear-gradient(to bottom, transparent, rgba(79, 140, 255, 0.8), transparent);
  box-shadow: 0 0 20px rgba(79, 140, 255, 0.6);
  animation: laserScanVertical 6s ease-in-out infinite;
}

.laser-vertical-2 {
  width: 2px;
  height: 100%;
  right: 25%;
  background: linear-gradient(to bottom, transparent, rgba(79, 140, 255, 0.8), transparent);
  box-shadow: 0 0 20px rgba(79, 140, 255, 0.6);
  animation: laserScanVertical 7s ease-in-out infinite reverse;
  animation-delay: 1.5s;
}

@keyframes laserScanHorizontal {
  0%, 100% {
    top: 20%;
    opacity: 0;
  }
  50% {
    top: 80%;
    opacity: 1;
  }
}

@keyframes laserScanVertical {
  0%, 100% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
}

/* Forensic Grid Crosshairs */
.forensic-grid {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.grid-crosshair {
  position: absolute;
  width: 60px;
  height: 60px;
  border: 2px solid rgba(53, 212, 136, 0.6);
  border-radius: 50%;
  animation: crosshairPulse 3s ease-in-out infinite;
}

.grid-crosshair::before,
.grid-crosshair::after {
  content: "";
  position: absolute;
  background: rgba(53, 212, 136, 0.6);
}

.grid-crosshair::before {
  width: 100%;
  height: 2px;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.grid-crosshair::after {
  width: 2px;
  height: 100%;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.crosshair-1 {
  top: 20%;
  left: 20%;
  animation-delay: 0s;
}

.crosshair-2 {
  top: 60%;
  right: 15%;
  animation-delay: 1s;
}

.crosshair-3 {
  bottom: 15%;
  left: 50%;
  animation-delay: 2s;
}

@keyframes crosshairPulse {
  0%, 100% {
    transform: scale(1) rotate(0deg);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.3) rotate(90deg);
    opacity: 1;
  }
}

/* Data Analysis Visualization */
.data-viz {
  position: absolute;
  top: 15%;
  right: 8%;
  width: 200px;
  height: 100px;
  opacity: 0.4;
}

.analysis-graph {
  width: 100%;
  height: 100%;
}

.graph-line {
  fill: none;
  stroke: rgba(53, 212, 136, 0.8);
  stroke-width: 2;
  stroke-dasharray: 400;
  stroke-dashoffset: 400;
  animation: drawGraph 4s ease-in-out infinite;
}

.graph-point {
  fill: rgba(79, 140, 255, 1);
  stroke: rgba(53, 212, 136, 1);
  stroke-width: 2;
  animation: pointPulse 2s ease-in-out infinite;
}

@keyframes drawGraph {
  0%, 20% {
    stroke-dashoffset: 400;
  }
  80%, 100% {
    stroke-dashoffset: 0;
  }
}

@keyframes pointPulse {
  0%, 100% {
    r: 3;
    opacity: 1;
  }
  50% {
    r: 5;
    opacity: 0.7;
  }
}

/* DNA Helix Effect */
.dna-helix {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.dna-strand {
  position: absolute;
  width: 4px;
  height: 100%;
  left: 20%;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(53, 212, 136, 0.6) 25%,
    rgba(79, 140, 255, 0.6) 50%,
    rgba(53, 212, 136, 0.6) 75%,
    transparent
  );
  animation: dnaFlow 8s ease-in-out infinite;
}

.dna-strand.strand-1 {
  left: 15%;
  animation-delay: 0s;
}

.dna-strand.strand-2 {
  left: 85%;
  animation-delay: 4s;
}

@keyframes dnaFlow {
  0%, 100% {
    transform: translateY(-100%) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(100%) rotate(720deg);
    opacity: 0;
  }
}

/* Floating Particles */
.particles {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 4px;
  height: 4px;
  background: rgba(53, 212, 136, 0.8);
  border-radius: 50%;
  box-shadow: 0 0 10px rgba(53, 212, 136, 0.8);
  animation: particleFloat 15s infinite ease-in-out;
}

.particle-0 {
  left: 10%;
  animation-delay: 0s;
  animation-duration: 12s;
}

.particle-1 {
  left: 30%;
  animation-delay: 2s;
  animation-duration: 15s;
  background: rgba(79, 140, 255, 0.8);
  box-shadow: 0 0 10px rgba(79, 140, 255, 0.8);
}

.particle-2 {
  left: 50%;
  animation-delay: 4s;
  animation-duration: 18s;
}

.particle-3 {
  left: 70%;
  animation-delay: 1s;
  animation-duration: 14s;
  background: rgba(255, 184, 79, 0.7);
  box-shadow: 0 0 10px rgba(255, 184, 79, 0.7);
}

.particle-4 {
  left: 90%;
  animation-delay: 3s;
  animation-duration: 16s;
  background: rgba(79, 140, 255, 0.8);
  box-shadow: 0 0 10px rgba(79, 140, 255, 0.8);
}

@keyframes particleFloat {
  0% {
    transform: translateY(100vh) translateX(0) scale(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  50% {
    transform: translateY(50vh) translateX(50px) scale(1.5);
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-10vh) translateX(-30px) scale(0);
    opacity: 0;
  }
}

/* Data Streams */
.data-streams {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  opacity: 0.3;
}

.stream {
  position: absolute;
  width: 2px;
  height: 100%;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(53, 212, 136, 1) 50%,
    transparent
  );
  animation: streamFlow 3s linear infinite;
}

.stream-1 {
  left: 25%;
  animation-delay: 0s;
}

.stream-2 {
  left: 45%;
  animation-delay: 0.5s;
  background: linear-gradient(to bottom, transparent, rgba(79, 140, 255, 1) 50%, transparent);
}

.stream-3 {
  left: 65%;
  animation-delay: 1s;
}

.stream-4 {
  left: 85%;
  animation-delay: 1.5s;
  background: linear-gradient(to bottom, transparent, rgba(79, 140, 255, 1) 50%, transparent);
}

@keyframes streamFlow {
  0% {
    transform: translateY(-100%);
  }
  100% {
    transform: translateY(100%);
  }
}

/* Fingerprint Scanner Effect */
.fingerprint-scanner {
  position: absolute;
  top: 20%;
  right: 10%;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 3px solid rgba(53, 212, 136, 0.4);
  background: radial-gradient(
    circle,
    transparent 30%,
    rgba(53, 212, 136, 0.05) 30%,
    rgba(53, 212, 136, 0.05) 32%,
    transparent 32%,
    transparent 45%,
    rgba(53, 212, 136, 0.05) 45%,
    rgba(53, 212, 136, 0.05) 47%,
    transparent 47%,
    transparent 60%,
    rgba(53, 212, 136, 0.05) 60%,
    rgba(53, 212, 136, 0.05) 62%,
    transparent 62%
  );
  animation: fingerprintPulse 3s ease-in-out infinite;
  overflow: hidden;
}

.scan-line {
  position: absolute;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, transparent, rgba(53, 212, 136, 0.8), transparent);
  box-shadow: 0 0 20px rgba(53, 212, 136, 0.8);
  animation: scanMove 2s linear infinite;
}

@keyframes fingerprintPulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 20px rgba(53, 212, 136, 0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(53, 212, 136, 0.6);
  }
}

@keyframes scanMove {
  0% {
    top: 0%;
  }
  100% {
    top: 100%;
  }
}

/* Central Forensic Robot Image */
.landing-hero-centerpiece {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 350px;
  z-index: 5;
}

.robot-glow-bg {
  position: absolute;
  inset: -50px;
  background: radial-gradient(
    circle,
    rgba(53, 212, 136, 0.3) 0%,
    rgba(79, 140, 255, 0.2) 50%,
    transparent 70%
  );
  filter: blur(40px);
  animation: glowPulse 4s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.robot-forensic-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 16px;
  position: relative;
  z-index: 2;
  filter: drop-shadow(0 20px 60px rgba(0, 0, 0, 0.6));
  animation: robotFloat 6s ease-in-out infinite;
}

@keyframes robotFloat {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-15px) scale(1.02);
  }
}

/* Scanning Overlay */
.scan-overlay {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  overflow: hidden;
  pointer-events: none;
}

.scan-line-vertical {
  position: absolute;
  width: 2px;
  height: 100%;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(53, 212, 136, 1),
    transparent
  );
  box-shadow: 0 0 20px rgba(53, 212, 136, 0.8);
  animation: scanVertical 3s linear infinite;
  left: 0;
}

.scan-line-horizontal {
  position: absolute;
  width: 100%;
  height: 2px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(79, 140, 255, 1),
    transparent
  );
  box-shadow: 0 0 20px rgba(79, 140, 255, 0.8);
  animation: scanHorizontal 4s linear infinite;
  top: 0;
  animation-delay: 1.5s;
}

@keyframes scanVertical {
  0% {
    left: 0%;
  }
  100% {
    left: 100%;
  }
}

@keyframes scanHorizontal {
  0% {
    top: 0%;
  }
  100% {
    top: 100%;
  }
}

/* Focus Corners */
.focus-corners {
  position: absolute;
  inset: -10px;
  pointer-events: none;
}

.corner-focus {
  position: absolute;
  width: 30px;
  height: 30px;
  border: 3px solid transparent;
  animation: cornerBlink 2s ease-in-out infinite;
}

.corner-tl {
  top: 0;
  left: 0;
  border-top-color: rgba(53, 212, 136, 1);
  border-left-color: rgba(53, 212, 136, 1);
}

.corner-tr {
  top: 0;
  right: 0;
  border-top-color: rgba(79, 140, 255, 1);
  border-right-color: rgba(79, 140, 255, 1);
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-bottom-color: rgba(79, 140, 255, 1);
  border-left-color: rgba(79, 140, 255, 1);
}

.corner-br {
  bottom: 0;
  right: 0;
  border-bottom-color: rgba(53, 212, 136, 1);
  border-right-color: rgba(53, 212, 136, 1);
}

@keyframes cornerBlink {
  0%, 100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}

/* Hero Logo - Old styles (keeping for fallback) */
.landing-hero-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 0 50px rgba(53, 212, 136, 0.6));
  z-index: 10;
}

.shield-outline {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 240px;
}

.shield-svg {
  width: 100%;
  height: 100%;
}

.shield-path {
  fill: none;
  stroke: rgba(53, 212, 136, 0.6);
  stroke-width: 3;
  stroke-dasharray: 400;
  stroke-dashoffset: 400;
  animation: drawShield 4s ease-in-out infinite;
  filter: drop-shadow(0 0 15px rgba(53, 212, 136, 0.8));
}

@keyframes drawShield {
  0%, 20% {
    stroke-dashoffset: 400;
  }
  40%, 100% {
    stroke-dashoffset: 0;
  }
}

.logo-core-wrapper {
  position: relative;
  width: 160px;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scanning-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 4px solid transparent;
  border-top-color: rgba(53, 212, 136, 0.8);
  border-right-color: rgba(79, 140, 255, 0.6);
  border-radius: 50%;
  animation: ringScan 3s linear infinite;
  box-shadow: 
    0 0 30px rgba(53, 212, 136, 0.4),
    inset 0 0 30px rgba(53, 212, 136, 0.2);
}

.scanning-ring::before {
  content: "";
  position: absolute;
  inset: -10px;
  border: 3px solid transparent;
  border-left-color: rgba(79, 140, 255, 0.5);
  border-bottom-color: rgba(53, 212, 136, 0.5);
  border-radius: 50%;
  animation: ringScan 2.5s linear infinite reverse;
}

.scanning-ring::after {
  content: "";
  position: absolute;
  inset: 10px;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  animation: ringScan 4s linear infinite;
}

.pulse-ring-1, .pulse-ring-2 {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid rgba(53, 212, 136, 0.6);
  border-radius: 50%;
  animation: pulseOut 3s ease-out infinite;
}

.pulse-ring-2 {
  animation-delay: 1.5s;
}

@keyframes pulseOut {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

@keyframes ringScan {
  to { transform: rotate(360deg); }
}

.hero-logo-core {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130px;
  height: 130px;
  background: linear-gradient(135deg, #35d488 0%, #4f8cff 50%, #35d488 100%);
  border-radius: 50%;
  color: white;
  text-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  box-shadow: 
    0 0 50px rgba(53, 212, 136, 0.9),
    0 0 100px rgba(79, 140, 255, 0.5),
    inset 0 0 40px rgba(255, 255, 255, 0.2);
  animation: logoGlow 3s ease-in-out infinite;
  overflow: hidden;
}

.ai-text {
  font-size: 3rem;
  font-weight: 900;
  letter-spacing: 4px;
  z-index: 2;
  position: relative;
}

.sparrow-logo {
  width: 80px;
  height: 80px;
  object-fit: contain;
  filter: drop-shadow(0 0 15px rgba(53, 212, 136, 0.8));
  animation: sparrowFloat 3s ease-in-out infinite;
  z-index: 2;
  position: relative;
}

@keyframes sparrowFloat {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-8px) scale(1.05);
  }
}

.logo-scanner {
  position: absolute;
  width: 120%;
  height: 3px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
  top: 0;
  left: -10%;
  animation: logoScanLine 3s linear infinite;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
}

@keyframes logoScanLine {
  0% {
    top: 0%;
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    top: 100%;
    opacity: 0;
  }
}

.hero-logo-core::before {
  content: "🔍";
  position: absolute;
  font-size: 2rem;
  top: -15px;
  right: -15px;
  filter: drop-shadow(0 0 20px rgba(53, 212, 136, 1));
  animation: magnifyBounce 4s ease-in-out infinite;
  z-index: 3;
}

.hero-logo-core::after {
  content: "";
  position: absolute;
  width: 40px;
  height: 40px;
  background: radial-gradient(circle, white 0%, transparent 70%);
  border-radius: 50%;
  top: 30px;
  right: 30px;
  opacity: 0.6;
  filter: blur(5px);
  animation: highlightShift 3s ease-in-out infinite;
}

@keyframes logoGlow {
  0%, 100% {
    box-shadow: 
      0 0 50px rgba(53, 212, 136, 0.9),
      0 0 100px rgba(79, 140, 255, 0.5),
      inset 0 0 40px rgba(255, 255, 255, 0.2);
  }
  50% {
    box-shadow: 
      0 0 80px rgba(53, 212, 136, 1),
      0 0 140px rgba(79, 140, 255, 0.7),
      0 0 180px rgba(53, 212, 136, 0.4),
      inset 0 0 50px rgba(255, 255, 255, 0.3);
  }
}

@keyframes magnifyBounce {
  0%, 100% { transform: rotate(0deg) scale(1) translateY(0); }
  25% { transform: rotate(-15deg) scale(1.15) translateY(-3px); }
  50% { transform: rotate(0deg) scale(1) translateY(0); }
  75% { transform: rotate(15deg) scale(1.15) translateY(-3px); }
}

@keyframes highlightShift {
  0%, 100% { transform: translate(0, 0); opacity: 0.6; }
  50% { transform: translate(-10px, -10px); opacity: 0.9; }
}

/* Large Focus Frame */
.large-focus-frame {
  position: absolute;
  inset: 80px;
  pointer-events: none;
  z-index: 8;
}

.frame-corner {
  position: absolute;
  width: 60px;
  height: 60px;
  border: 3px solid transparent;
  animation: frameBlink 3s ease-in-out infinite;
}

.frame-tl {
  top: 0;
  left: 0;
  border-top-color: rgba(53, 212, 136, 0.8);
  border-left-color: rgba(53, 212, 136, 0.8);
}

.frame-tr {
  top: 0;
  right: 0;
  border-top-color: rgba(79, 140, 255, 0.8);
  border-right-color: rgba(79, 140, 255, 0.8);
}

.frame-bl {
  bottom: 0;
  left: 0;
  border-bottom-color: rgba(79, 140, 255, 0.8);
  border-left-color: rgba(79, 140, 255, 0.8);
}

.frame-br {
  bottom: 0;
  right: 0;
  border-bottom-color: rgba(53, 212, 136, 0.8);
  border-right-color: rgba(53, 212, 136, 0.8);
}

@keyframes frameBlink {
  0%, 100% {
    opacity: 0.6;
    box-shadow: 0 0 15px currentColor;
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 30px currentColor;
  }
}

/* Hero Content */
.landing-hero-content {
  position: relative;
  z-index: 10;
  max-width: 1100px;
  animation: fadeInUp 1s ease;
}

/* Top Logo Badge */
.hero-top-logo {
  margin-bottom: 30px;
  animation: fadeIn 1.5s ease;
}

.logo-badge-wrapper {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 10px 24px;
  background: rgba(22, 26, 33, 0.85);
  border: 2px solid rgba(53, 212, 136, 0.5);
  border-radius: 40px;
  backdrop-filter: blur(15px);
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.4),
    0 0 40px rgba(53, 212, 136, 0.3);
  animation: logoBadgeFloat 4s ease-in-out infinite;
}

@keyframes logoBadgeFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

.hero-sparrow-small {
  width: 35px;
  height: 35px;
  object-fit: contain;
  filter: drop-shadow(0 0 15px rgba(53, 212, 136, 0.8));
  animation: sparrowSpin 8s linear infinite;
}

@keyframes sparrowSpin {
  0%, 90% {
    transform: rotate(0deg);
  }
  95%, 100% {
    transform: rotate(360deg);
  }
}

.logo-text {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5px;
  text-shadow: 0 0 20px rgba(53, 212, 136, 0.5);
}

.landing-hero-content {
  position: relative;
  z-index: 10;
  max-width: 1000px;
  animation: fadeInUp 1s ease;
}

.landing-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: rgba(79, 140, 255, 0.1);
  border: 1px solid rgba(79, 140, 255, 0.3);
  border-radius: 30px;
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-bottom: 32px;
  backdrop-filter: blur(10px);
}

.badge-icon {
  font-size: 1rem;
}

.badge-separator {
  color: rgba(79, 140, 255, 0.5);
}

.landing-hero h1 {
  font-size: 4rem;
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 28px;
  color: var(--text-primary);
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.gradient-text-blue {
  background: linear-gradient(135deg, #4f8cff 0%, #6ea8ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-green {
  background: linear-gradient(135deg, #35d488 0%, #5ee3a5 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.landing-hero p {
  font-size: 1.25rem;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 48px;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.landing-hero-actions {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-hero {
  padding: 14px 32px;
  font-size: 1.05rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border-radius: 12px;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.btn-hero:hover {
  transform: translateY(-3px);
}

.btn-icon {
  font-size: 1.2rem;
}

.btn-ghost {
  background: transparent;
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 10px 24px;
  border-radius: var(--radius);
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-ghost:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* Steps Section */
.landing-steps {
  padding: 100px 5%;
  background: var(--bg-panel);
  position: relative;
  overflow: hidden;
}

/* Animated Circuit Lines Background */
.steps-circuit-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  opacity: 0.2;
  pointer-events: none;
}

.circuit-svg {
  width: 100%;
  height: 100%;
}

.circuit-line {
  stroke: rgba(53, 212, 136, 0.6);
  stroke-width: 2;
  stroke-dasharray: 1200;
  stroke-dashoffset: 1200;
  animation: drawCircuitLine 8s ease-in-out infinite;
}

.line-1 { animation-delay: 0s; }
.line-2 { animation-delay: 2s; }
.line-3 { animation-delay: 4s; }
.line-4 { animation-delay: 6s; }

@keyframes drawCircuitLine {
  0%, 20% {
    stroke-dashoffset: 1200;
    opacity: 0;
  }
  40%, 80% {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  100% {
    stroke-dashoffset: -1200;
    opacity: 0;
  }
}

.circuit-connector {
  stroke: rgba(79, 140, 255, 0.6);
  stroke-width: 2;
  stroke-dasharray: 200;
  stroke-dashoffset: 200;
  animation: drawConnector 4s ease-in-out infinite;
}

.conn-1 { animation-delay: 1s; }
.conn-2 { animation-delay: 2s; }
.conn-3 { animation-delay: 3s; }
.conn-4 { animation-delay: 4s; }

@keyframes drawConnector {
  0%, 30% {
    stroke-dashoffset: 200;
  }
  60%, 100% {
    stroke-dashoffset: 0;
  }
}

.circuit-node {
  fill: rgba(53, 212, 136, 1);
  filter: drop-shadow(0 0 10px rgba(53, 212, 136, 0.8));
  animation: nodeBlink 2s ease-in-out infinite;
}

.node-1 { animation-delay: 0.5s; }
.node-2 { animation-delay: 1.5s; }
.node-3 { animation-delay: 2.5s; }
.node-4 { animation-delay: 3.5s; }

@keyframes nodeBlink {
  0%, 100% {
    opacity: 0.4;
    r: 5;
  }
  50% {
    opacity: 1;
    r: 8;
  }
}

.landing-steps h2,
.landing-features h2 {
  text-align: center;
  font-size: 2.5rem;
  margin-bottom: 16px;
  position: relative;
  z-index: 1;
}

.landing-section-sub {
  text-align: center;
  color: var(--text-secondary);
  font-size: 1.1rem;
  margin-bottom: 60px;
  position: relative;
  z-index: 1;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 32px;
  max-width: 1300px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* New Step Card Design */
.step-card-new {
  background: linear-gradient(145deg, var(--bg-dark) 0%, rgba(22, 26, 33, 0.9) 100%);
  border: 2px solid var(--border-color);
  border-radius: 12px;
  padding: 32px 24px;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.step-card-new:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: rgba(53, 212, 136, 0.8);
  box-shadow: 
    0 20px 40px rgba(0, 0, 0, 0.5),
    0 0 40px rgba(53, 212, 136, 0.3);
}

/* Animated Glow Effect */
.step-glow-effect {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
    rgba(53, 212, 136, 0.15) 0%,
    transparent 50%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}

.step-card-new:hover .step-glow-effect {
  opacity: 1;
}

/* Step Header */
.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.step-icon-wrapper {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, rgba(53, 212, 136, 0.2), rgba(79, 140, 255, 0.2));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.4s ease;
}

.step-card-new:hover .step-icon-wrapper {
  transform: rotate(360deg) scale(1.1);
}

.step-icon-wrapper::before {
  content: "";
  position: absolute;
  inset: -3px;
  background: linear-gradient(45deg, var(--accent), var(--success));
  border-radius: 50%;
  opacity: 0;
  z-index: -1;
  filter: blur(8px);
  transition: opacity 0.4s ease;
}

.step-card-new:hover .step-icon-wrapper::before {
  opacity: 0.6;
  animation: iconGlow 1.5s ease-in-out infinite;
}

@keyframes iconGlow {
  0%, 100% {
    filter: blur(8px);
    opacity: 0.6;
  }
  50% {
    filter: blur(12px);
    opacity: 0.9;
  }
}

.step-icon {
  font-size: 2rem;
  filter: drop-shadow(0 0 8px rgba(53, 212, 136, 0.6));
}

.step-number {
  font-size: 3rem;
  font-weight: 900;
  background: linear-gradient(135deg, rgba(53, 212, 136, 0.3), rgba(79, 140, 255, 0.3));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  opacity: 0.5;
  position: absolute;
  right: 20px;
  top: 20px;
  line-height: 1;
  transition: all 0.4s ease;
}

.step-card-new:hover .step-number {
  opacity: 0.8;
  background: linear-gradient(135deg, var(--success), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.step-card-new h3 {
  font-size: 1.3rem;
  margin-bottom: 14px;
  color: var(--text-primary);
  position: relative;
  z-index: 1;
}

.step-card-new p {
  color: var(--text-secondary);
  line-height: 1.7;
  font-size: 0.95rem;
  position: relative;
  z-index: 1;
}

/* Corner Decorations */
.step-corner {
  position: absolute;
  width: 20px;
  height: 20px;
  border: 2px solid transparent;
  opacity: 0;
  transition: all 0.4s ease;
}

.corner-tl {
  top: 0;
  left: 0;
  border-top-color: var(--success);
  border-left-color: var(--success);
}

.corner-tr {
  top: 0;
  right: 0;
  border-top-color: var(--accent);
  border-right-color: var(--accent);
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-bottom-color: var(--accent);
  border-left-color: var(--accent);
}

.corner-br {
  bottom: 0;
  right: 0;
  border-bottom-color: var(--success);
  border-right-color: var(--success);
}

.step-card-new:hover .step-corner {
  opacity: 1;
}

.step-card-new:hover .corner-tl {
  top: 8px;
  left: 8px;
}

.step-card-new:hover .corner-tr {
  top: 8px;
  right: 8px;
}

.step-card-new:hover .corner-bl {
  bottom: 8px;
  left: 8px;
}

.step-card-new:hover .corner-br {
  bottom: 8px;
  right: 8px;
}

/* Features Section */
.landing-features {
  padding: 100px 5%;
}

.landing-features .grid {
  max-width: 1300px;
  margin: 0 auto;
  gap: 32px;
}

.feature-card {
  position: relative;
  padding: 40px 32px;
  background: linear-gradient(135deg, var(--bg-panel) 0%, rgba(22, 26, 33, 0.8) 100%);
  border: 1px solid var(--border-color);
  transition: all 0.4s ease;
  animation: fadeInUp 0.6s ease backwards;
}

.feature-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(79, 140, 255, 0.05), rgba(53, 212, 136, 0.05));
  opacity: 0;
  transition: opacity 0.4s ease;
  border-radius: var(--radius);
}

.feature-card:hover::before {
  opacity: 1;
}

.feature-card:hover {
  transform: translateY(-8px);
  border-color: var(--accent);
  box-shadow: 0 16px 40px rgba(79, 140, 255, 0.3);
}

.feature-icon {
  position: relative;
  width: 90px;
  height: 90px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-circle {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, rgba(79, 140, 255, 0.2), rgba(53, 212, 136, 0.2));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  position: relative;
  z-index: 2;
  transition: transform 0.4s ease;
  border: 3px solid rgba(79, 140, 255, 0.3);
}

.feature-card:hover .icon-circle {
  transform: scale(1.15) rotate(5deg);
  border-color: var(--accent);
  box-shadow: 0 0 30px rgba(79, 140, 255, 0.5);
}

.icon-ripple {
  position: absolute;
  inset: 0;
  border: 2px solid var(--accent);
  border-radius: 50%;
  opacity: 0;
  animation: rippleExpand 2s ease-out infinite;
}

.feature-card:hover .icon-ripple {
  animation: rippleExpand 1.5s ease-out infinite;
}

@keyframes rippleExpand {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.feature-badge {
  display: inline-block;
  margin-top: 16px;
  padding: 6px 14px;
  background: rgba(79, 140, 255, 0.15);
  border: 1px solid rgba(79, 140, 255, 0.3);
  border-radius: 20px;
  font-size: 0.8rem;
  color: var(--accent);
  font-weight: 600;
  letter-spacing: 0.5px;
}

.feature-card h3 {
  text-align: center;
  font-size: 1.35rem;
  margin-bottom: 16px;
}

.feature-card p {
  text-align: center;
  line-height: 1.7;
}

/* Footer */
.landing-footer {
  position: relative;
  padding: 60px 5%;
  background: linear-gradient(135deg, #0a0e1a 0%, #1a1f2e 100%);
  border-top: 1px solid var(--border-color);
  overflow: hidden;
}

.footer-wave {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, 
    var(--accent) 0%, 
    var(--success) 25%, 
    var(--accent) 50%, 
    var(--success) 75%, 
    var(--accent) 100%
  );
  background-size: 200% 100%;
  animation: waveFlow 3s linear infinite;
}

@keyframes waveFlow {
  0% {
    background-position: 0% 0%;
  }
  100% {
    background-position: 200% 0%;
  }
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1300px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.footer-left {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: 8px;
}

.footer-left p {
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.footer-right {
  display: flex;
  gap: 16px;
  align-items: center;
}

.btn-pulse {
  animation: btnPulseEffect 2s ease-in-out infinite;
}

@keyframes btnPulseEffect {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(79, 140, 255, 0.7);
  }
  50% {
    box-shadow: 0 0 0 15px rgba(79, 140, 255, 0);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .landing-hero h1 {
    font-size: 2.2rem;
  }
  
  .landing-hero p {
    font-size: 1rem;
  }
  
  .landing-nav-links a {
    display: none;
  }
  
  .steps-grid {
    grid-template-columns: 1fr;
  }

  /* Centerpiece Robot Image */
  .landing-hero-centerpiece {
    width: 90%;
    max-width: 400px;
    height: 280px;
  }

  /* Simplify animations on mobile */
  .float-icon {
    display: none;
  }

  .float-icon:nth-child(1),
  .float-icon:nth-child(4) {
    display: block;
  }

  .icon-card {
    width: 50px;
    height: 50px;
    font-size: 1.8rem;
  }

  .connection-lines {
    opacity: 0.1;
  }

  .glow-orbs .orb {
    width: 200px;
    height: 200px;
  }

  .landing-hero-actions {
    flex-direction: column;
    gap: 12px;
  }

  .landing-hero-actions .btn {
    width: 100%;
  }

  .footer-content {
    flex-direction: column;
    gap: 24px;
    text-align: center;
  }

  .footer-left {
    align-items: center;
  }

  .steps-circuit-bg {
    opacity: 0.1;
  }

  .grid-crosshair {
    width: 40px;
    height: 40px;
  }

  .step-number {
    font-size: 2rem;
    right: 15px;
    top: 15px;
  }

  .step-icon-wrapper {
    width: 50px;
    height: 50px;
  }

  .step-icon {
    font-size: 1.5rem;
  }

  .landing-badge {
    font-size: 0.75rem;
    padding: 8px 14px;
  }

  .btn-hero {
    padding: 12px 24px;
    font-size: 0.95rem;
  }
}

/* Smooth scroll behavior */
html {
  scroll-behavior: smooth;
}

/* ---------------- Tables ---------------- */
table {
  width: 100%;
  border-collapse: collapse;
  animation: fadeIn var(--transition-med) ease;
}

th, td {
  text-align: left;
  padding: 10px 12px;
  border-bottom: 1px solid var(--border-color);
  font-size: 0.88rem;
}

th {
  color: var(--text-secondary);
  font-weight: 500;
}

tbody tr {
  transition: background var(--transition-fast);
}

tbody tr:hover {
  background: var(--bg-panel-alt);
}

/* ---------------- Badges ---------------- */
.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  animation: fadeIn var(--transition-fast) ease;
}

.badge-success { background: rgba(53, 212, 136, 0.15); color: var(--success); }
.badge-warning { background: rgba(255, 184, 79, 0.15); color: var(--warning); }
.badge-danger  { background: rgba(255, 92, 92, 0.15); color: var(--danger); }
.badge-neutral { background: rgba(79, 140, 255, 0.15); color: var(--accent); }

/* ---------------- Grid utilities ---------------- */
.grid {
  display: grid;
  gap: 16px;
}

.grid-cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

@media (max-width: 900px) {
  .grid-cols-3, .grid-cols-2 {
    grid-template-columns: 1fr;
  }
  .sidebar {
    width: 70px;
  }
  .sidebar-link span {
    display: none;
  }
}

/* ---------------- Scrollbar ---------------- */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}
